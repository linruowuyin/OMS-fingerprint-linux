# Maintainer: BlueApple233 <blueapple233_@outlook.com>
#
# libfprint with the OMS match-on-chip driver (USB 33a7:2388) added.
# The driver itself is submitted upstream; this package is the fallback for
# users whose device is not supported by the distribution package yet.
#
# See https://github.com/BlueApple233/OMS-fingerprint-linux

pkgname=libfprint-omsmoc
pkgver=1.94.100
pkgrel=2
pkgdesc="Library to access fingerprint readers, with the OMS match-on-chip driver (33a7:2388)"
arch=('x86_64' 'aarch64')
url="https://github.com/BlueApple233/OMS-fingerprint-linux"
license=('LGPL-2.1-or-later')
depends=('glib2' 'libgudev' 'libgusb' 'libusb' 'openssl' 'pixman' 'cairo')
makedepends=('meson' 'ninja' 'gobject-introspection' 'glib2-devel')
provides=('libfprint' 'libfprint-2.so=2-64')
# 只与 libfprint 2.x 冲突：遗留的 libfprint-1（provides libfprint=1.0）可以被
# fingerprint-gui 等包继续使用，不该被本包顶掉。
conflicts=('libfprint>=1.90')
options=('!emptydirs')
source=("https://gitlab.freedesktop.org/libfprint/libfprint/-/archive/v$pkgver/libfprint-v$pkgver.tar.gz"
        "omsmoc-driver.patch"
        "70-oms-fingerprint.rules")
sha256sums=('edc90e02f330a7595ceaf37f2c6ec32ed43541347fe936d3273b0bb2524fd19c'
            '181e3ab5d960e07763dcd45c271ef9b154a5ee7ba37a4e83320248a34b6979f2'
            '17dd648e4182eac217d4db1e035b0e751925ff2e7b32f696bc962bf99620d220')

prepare() {
  cd "libfprint-v$pkgver"
  patch -Np1 -i "$srcdir/omsmoc-driver.patch"
}

build() {
  cd "libfprint-v$pkgver"
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Ddrivers=default \
    -Ddoc=false \
    -Dgtk-examples=false \
    -Dinstalled-tests=false \
    -Dudev_rules=enabled \
    -Dudev_hwdb=enabled
  meson compile -C build
}

package() {
  cd "libfprint-v$pkgver"
  meson install -C build --destdir "$pkgdir"

  # 这颗芯片扛不住 autosuspend，必须常供电；规则随包安装，装完即可用。
  install -Dm644 "$srcdir/70-oms-fingerprint.rules" \
    "$pkgdir/usr/lib/udev/rules.d/70-oms-fingerprint.rules"
}
