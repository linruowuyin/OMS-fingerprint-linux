index 0000000..0f12ef2
--- /dev/null
+++ b/libfprint/drivers/omsmoc/omsmoc.c
@@ -0,0 +1,1811 @@
+/*
+ * OMS Match-on-Chip driver for libfprint
+ * Copyright (C) 2026 The OMS Linux driver contributors
+ *
