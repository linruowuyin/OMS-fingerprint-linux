# Maintainer: 你的名字 <you@example.com>
#
# 非官方构建：机械革命无界 14 Pro 的指纹驱动。
# 适用芯片：仅 USB 33a7:2388（江西欧迈斯/欧菲光 match-on-chip）。
# 其它机型若确认也是这颗芯片，可以装（驱动/udev 规则都只匹配该 ID，不会误伤别的传感器），
# 但未在那些机器上测试过。芯片不是 33a7:2388 的话，本包装了也不会有任何作用。
#
# 驱动本体来自 BlueApple233/OMS-fingerprint-linux（LGPL-2.1-or-later）。
# 本包相对上游发布版的改动（都已提交给原作者，见仓库的 upstream/ 目录）：
#   1. 协议层拆成 drivers/omsmoc/omsmoc_proto.c（与 goodixmoc 等 MoC 驱动同布局）
#   2. 新增帧编解码单元测试，并注册进 meson 的 unit-tests
#   3. 修正 udev 策略：强制 power/control=on（该芯片扛不住 autosuspend），
#      且不加 uaccess（fprintd 以 root 运行，无需把设备直连权限开放给本地用户）
#   4. 补上 tests/omsmoc/ 回放文件（上游发布版缺这些文件会导致 meson 断言失败）
#
# 注意：本包 provides/conflicts libfprint。官方 libfprint 每次升级后都需要重建本包，
# 否则 pacman -Syu 会报冲突。

pkgname=libfprint-omsmoc-wujie14pro
pkgver=1.94.100
pkgrel=1
pkgdesc="OMS 33a7:2388 match-on-chip fingerprint driver (libfprint replacement), for the MECHREVO Wujie 14 Pro"
arch=('x86_64' 'aarch64')
url="https://github.com/BlueApple233/OMS-fingerprint-linux"
license=('LGPL-2.1-or-later')
depends=('glib2' 'libgudev' 'libgusb' 'libusb' 'openssl' 'pixman' 'cairo')
makedepends=('meson' 'ninja' 'gobject-introspection' 'glib2-devel')
provides=('libfprint' 'libfprint-2.so=2-64')
# 只与 libfprint 2.x 冲突：遗留的 libfprint-1（provides libfprint=1.0）可以被
# fingerprint-gui 等包继续使用，不该被本包顶掉。
conflicts=('libfprint>=1.90' 'libfprint-omsmoc')
options=('!emptydirs')
# 补丁托管在 GitHub 的 raw 链接上（AUR 不允许随包携带本地文件）。
# 把你自己的 GitHub 用户名填进 _ghuser，仓库名默认 omsmoc-patches，tag 用 v$pkgver。
_ghuser=CHANGE_ME
source=("https://gitlab.freedesktop.org/libfprint/libfprint/-/archive/v$pkgver/libfprint-v$pkgver.tar.gz"
        "https://raw.githubusercontent.com/$_ghuser/omsmoc-patches/v$pkgver/omsmoc-driver.patch")
sha256sums=('edc90e02f330a7595ceaf37f2c6ec32ed43541347fe936d3273b0bb2524fd19c'
            '181e3ab5d960e07763dcd45c271ef9b154a5ee7ba37a4e83320248a34b6979f2')

prepare() {
  cd "libfprint-v$pkgver"
  patch -Np1 -i "$srcdir/omsmoc-driver.patch"
}

build() {
  cd "libfprint-v$pkgver"
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Ddrivers=default \
    -Ddoc=false \
    -Dgtk-examples=false \
    -Dinstalled-tests=false \
    -Dudev_rules=enabled \
    -Dudev_hwdb=enabled
  meson compile -C build
}

check() {
  cd "libfprint-v$pkgver"
  # 只跑协议层单元测试：不需要硬件，也不需要 umockdev
  meson test -C build omsmoc-proto --print-errorlogs
}

package() {
  cd "libfprint-v$pkgver"
  meson install -C build --destdir "$pkgdir"

  # 这颗芯片扛不住内核 autosuspend，必须常供电。
  # 不加 uaccess：fprintd 以 root 运行，加了等于把设备直连权限开放给所有本地用户。
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/70-oms-fingerprint.rules" <<'EOF'
# OMS 33a7:2388 指纹传感器：必须常供电（芯片扛不住内核 autosuspend）。
# 不要加 TAG+="uaccess"：fprintd 以 root 运行，加了等于把设备直连权限
# （含删除芯片模板）开放给所有本地用户。
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="33a7", ATTR{idProduct}=="2388", ATTR{power/control}="on"
EOF
}
